<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<div class="container my-4" style="max-width: 600px;">
  <div class="card">
    <div class="card-header">
      <h3 class="card-title">ยืมอุปกรณ์</h3>
    </div>
    <div class="card-body">
      <% if (error) { %>
        <div class="alert alert-danger"><%= error %></div>
      <% } %>

      <form action="/borrowings" method="POST">
        <div class="mb-3">
          <label class="form-label required">นักศึกษา</label>
          <select name="student_id" class="form-select" required>
            <option value="">-- เลือกนักศึกษา --</option>
            <% students.forEach(s => { %>
              <option value="<%= s.student_id %>">[<%= s.student_id %>] <%= s.full_name %></option>
            <% }) %>
          </select>
        </div>

        <div class="mb-3">
          <label class="form-label required">อุปกรณ์ (เฉพาะที่พร้อมใช้งาน)</label>
          <select name="equipment_id" class="form-select" required>
            <option value="">-- เลือกอุปกรณ์ --</option>
            <% equipment.forEach(eq => { %>
              <option value="<%= eq.equipment_id %>">[<%= eq.code %>] <%= eq.name %></option>
            <% }) %>
          </select>
        </div>

        <div class="mb-3">
          <label class="form-label required">กำหนดวัน-เวลาคืน</label>
          <input type="datetime-local" name="due_at" class="form-control" required>
        </div>

        <div class="d-flex justify-content-between">
          <a href="/borrowings" class="btn btn-secondary">ยกเลิก</a>
          <button type="submit" class="btn btn-primary">บันทึกการยืม</button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>