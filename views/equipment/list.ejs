<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<div class="page-body">
  <div class="container-xl">
    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title">รายการอุปกรณ์</h3>
        <a href="/equipment/new" class="btn btn-primary">+ เพิ่มอุปกรณ์</a>
      </div>
      
      <div class="table-responsive">
        <table class="table table-vcenter card-table">
          <thead>
            <tr>
              <!-- เพิ่มหัวตาราง: ภาพ -->
              <th class="w-1">ภาพ</th>
              <th>รหัสอุปกรณ์</th>
              <th>ชื่ออุปกรณ์</th>
              <th>ประเภท</th>
              <th>สถานะ</th>
              <th class="text-end">จัดการ</th>
            </tr>
          </thead>
          <tbody>
            <% if (items && items.length > 0) { %>
              <% items.forEach(item => { %>
                <tr>
                  <!-- แสดงรูปภาพพร้อม Fallback -->
                  <td>
                    <% if (item.image_path) { %>
                      <img src="<%= item.image_path %>" 
                           alt="<%= item.name %>" 
                           class="avatar avatar-sm rounded"
                           onerror="this.onerror=null; this.src='https://placehold.co/100x100?text=No+Image';">
                    <% } else { %>
                      <!-- Fallback กรณีไม่มี image_path ใน DB -->
                      <img src="https://placehold.co/100x100?text=No+Image" 
                           alt="No Image" 
                           class="avatar avatar-sm rounded">
                    <% } %>
                  </td>
                  <td><%= item.code %></td>
                  <td><%= item.name %></td>
                  <td><%= item.category %></td>
                  <td>
                    <% if (item.status === 'AVAILABLE') { %>
                      <span class="badge bg-success-lt">AVAILABLE</span>
                    <% } else { %>
                      <span class="badge bg-warning-lt">BORROWED</span>
                    <% } %>
                  </td>
                  <td class="text-end">
                    <a href="/equipment/<%= item.equipment_id %>" class="btn btn-sm btn-outline-info">ดูรายละเอียด</a>
                    <a href="/equipment/<%= item.equipment_id %>/edit" class="btn btn-sm btn-outline-warning">แก้ไข</a>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="6" class="text-center text-secondary py-4">ไม่พบข้อมูลอุปกรณ์</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>